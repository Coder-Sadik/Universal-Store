# ==============================================================================
# Local Environment Configuration Template (.env.example)
# Copy this file to .env and configure strong, secret values before running docker-compose.
# NEVER commit the actual .env file to git.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_strong_postgres_password

# Redis Configuration
REDIS_PASSWORD=your_strong_redis_password

# Application Connection Strings (for Medusa backend in Step 0.2)
DATABASE_URL=postgres://your_database_user:your_strong_postgres_password@127.0.0.1:5432/your_database_name
REDIS_URL=redis://:your_strong_redis_password@127.0.0.1:6379
