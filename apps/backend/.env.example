# ==============================================================================
# Medusa Backend Environment Example (apps/backend/.env.example)
# Copy to apps/backend/.env and populate secret values. NEVER commit .env to git.
# ==============================================================================

# PostgreSQL & Redis (Matches docker-compose.yml services)
DATABASE_URL=postgres://your_database_user:your_strong_postgres_password@127.0.0.1:5432/your_database_name
REDIS_URL=redis://:your_strong_redis_password@127.0.0.1:6379

# CORS Origins (Explicit localhost origins only - no wildcards)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
COOKIE_SECRET=
